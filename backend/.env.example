# ─── Server ───
NODE_ENV=development
PORT=5000

# ─── MongoDB ───
MONGODB_URI=mongodb://127.0.0.1:27017/nourishbridge

# ─── CORS (comma-separated origins) ───
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── API ───
API_PREFIX=/api/v1

# ─── Security ───
# Set TRUST_PROXY=true when running behind nginx, load balancer, or cloud proxy
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# ─── JWT (required in production — min 32 characters) ───
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate limiting (skipped in development by default) ───
RATE_LIMIT_SKIP_IN_DEV=true
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_FORGOT_WINDOW_MS=900000
RATE_LIMIT_FORGOT_MAX=5

# ─── Admin seed (scripts/seed-admin.js) ───
ADMIN_SEED_EMAIL=admin@nourishbridge.local
ADMIN_SEED_PASSWORD=AdminPass123

# ─── Email (Nodemailer — Brevo SMTP compatible) ───
# Brevo: host=smtp-relay.brevo.com, port=587, user=your-brevo-login-email, pass=your-brevo-smtp-key
EMAIL_FROM=NourishBridge <noreply@nourishbridge.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Password Reset OTP (required in production — min 32 characters) ───
OTP_SECRET=your-otp-hmac-secret-min-32-chars
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3

# ─── Uploads ───
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880

# ─── Maps (optional — Google Maps Platform) ───
GOOGLE_MAPS_API_KEY=

# ─── Cloudinary (optional — production image CDN) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
