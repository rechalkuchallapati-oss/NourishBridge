# Production backend — set in Render/Railway dashboard (never commit values)

NODE_ENV=production
PORT=10000
TRUST_PROXY=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nourishbridge?retryWrites=true&w=majority

# Frontend URL(s) — comma-separated
CORS_ORIGIN=https://your-app.vercel.app

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP / password reset
OTP_SECRET=
OTP_EXPIRY_MINUTES=10

# Rate limiting — MUST be enabled in production
RATE_LIMIT_SKIP_IN_DEV=false
RATE_LIMIT_API_MAX=300

# Email — Brevo SMTP
EMAIL_FROM=NourishBridge <noreply@yourdomain.com>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Maps
GOOGLE_MAPS_API_KEY=

# Images — Cloudinary (recommended for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
UPLOAD_MAX_FILE_SIZE=5242880
