{
  "name": "nourishbridge-backend",
  "version": "1.0.0",
  "description": "NourishBridge API — Node.js, Express, MongoDB",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "echo \"Add ESLint when ready\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/auth tests/profile tests/errors tests/security",
    "test:integration": "vitest run tests/donations tests/ngo tests/volunteer tests/deliveries tests/inventory tests/food-requests tests/notifications tests/support tests/reports",
    "test:e2e": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run --coverage",
    "test:legacy": "node scripts/test-e2e-complete.js",
    "test:legacy:all": "node scripts/test-auth-complete.js && node scripts/test-workflow.js && node scripts/test-delivery.js && node scripts/test-phases-11-20.js && node scripts/test-e2e-complete.js",
    "test:security": "vitest run tests/security tests/authorization",
    "test:perf": "vitest run tests/performance",
    "perf:load": "node scripts/perf-load-test.js"
  },
  "keywords": [
    "nourishbridge",
    "express",
    "mongodb",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
