# Backend API base URL (no trailing slash)
# Leave unset in local dev to use Vite proxy (/api/v1 → http://127.0.0.1:5000)
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# If backend runs on a different port during dev:
# VITE_API_PROXY_TARGET=http://127.0.0.1:5022

# Optional — Google Maps Platform (falls back to OpenStreetMap embed)
VITE_GOOGLE_MAPS_API_KEY=
