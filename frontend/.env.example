# Backend API base URL (required for production builds on Vercel)
# Example: https://your-api.onrender.com/api/v1
VITE_API_BASE_URL=

# Optional — WebSocket origin if different from API host (defaults from VITE_API_BASE_URL)
# VITE_SOCKET_URL=https://your-api.onrender.com

# If backend runs on a different port during local dev:
# VITE_API_PROXY_TARGET=http://127.0.0.1:5022

# Optional — Google Maps Platform (falls back to OpenStreetMap embed)
VITE_GOOGLE_MAPS_API_KEY=
